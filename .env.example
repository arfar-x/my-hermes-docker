# ==============================================================================
# Hermes Docker — environment configuration
# Copy to `.env` and fill in what you need: `cp .env.example .env`
# Full explanations live in README.md.
# ==============================================================================

# --- Host identity ---
# Your host user's ids (`id -u` / `id -g`). The container must start as root
# (s6-overlay's own boot contract, see README) then remaps its internal
# "hermes" user to these values and drops privileges — so anything Hermes
# writes into the bind mounts below comes out owned by you, not root.
# 1000:1000 is correct on most single-user Linux boxes; check if unsure.
UID=1000
GID=1000

# --- Bind mounts ---
# These are the ONLY two paths that exist inside the container — nothing
# else on the host is reachable, no matter which Hermes tools/abilities are
# turned on. Paths are absolute or relative to this file; override per-run
# without editing compose.yml.

# The one folder Hermes can read/write — its /workspace. Point it at a fresh
# folder per task if you want clean separation between jobs.
HERMES_PROJECT_DIR=./project

# Hermes' own config/session/auth/skills state — its /opt/data.
#
# `.hermes` is the conventional home directory other tooling assumes by
# default — `npx skills` (skills-cli) and a native `hermes-agent` install
# both fall back to it. Keeping the default here means `npx skills add
# <repo> -a hermes-agent` works with zero extra flags.
#
# Tradeoff: if you ever install and run Hermes natively on THIS SAME host,
# that process gets full filesystem access and will read/write this exact
# directory — session history, provider credentials, installed skills —
# with none of the container's confinement. See README → "Native vs.
# Dockerized Hermes". If you don't intend to ever run Hermes outside this
# container, the default is fine. To rule the collision out entirely, point
# this at a non-conventional path instead (e.g. ${HOME}/hermes-home) — you'll
# then need to pass HERMES_HOME=<path> explicitly to `npx skills`, which the
# `make skill-*` targets already do for you.
HERMES_HOME_DIR=${HOME}/.hermes

# --- Optional skill-source mounts ---
# Both are genuinely optional: leave commented out and `make up`/`make down`
# won't add these mounts at all — no placeholder, no empty folder, the
# sandbox stays at exactly the two paths above. Set either (or both) and the
# matching compose.skills.yml / compose.agents-skills.yml fragment gets
# merged in automatically by `make`. See README → "Mounting your own skills
# directory" for the full explanation, including the config.yaml wiring.

# Your own skill sources (SKILL.md folders), mounted read-only at /skills-src.
# Point it at the directory that directly *contains* your skill folders —
# e.g. if your skills live in a git repo at ~/dev/my-skills/skills/<name>/
# SKILL.md, set this to ~/dev/my-skills/skills, not the repo root (keeps
# .git/, venv/, and other repo clutter out of the sandbox).
# HERMES_EXTERNAL_SKILLS_DIR=/path/to/your/skills-repo/skills

# The skills-cli (`npx skills`) canonical global store, mounted read-only at
# /skills-src-agents. Anything installed with `npx skills add <repo> -g` for
# ANY agent on this host shows up in Hermes too.
# HERMES_AGENTS_SKILLS_DIR=${HOME}/.agents/skills

# --- Provider credentials ---
# Referenced by config.yaml (inside HERMES_HOME_DIR) — add whichever
# provider(s) your config actually uses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ...add whichever provider keys your config.yaml references

# --- Dashboard (off by default) ---
# Doesn't start unless HERMES_DASHBOARD is truthy, and fails closed without
# an auth provider configured. Binds 0.0.0.0 *inside* the container (needed
# for Docker's own port publishing to reach it) — compose.yml still only
# ever exposes the published port to 127.0.0.1, never your LAN.
# Uncomment and set a real password to use it:
# HERMES_DASHBOARD=true
# HERMES_DASHBOARD_PORT=8642
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=changeme

# --- Third-party integrations ---
# Only add tokens for services you actually want Hermes to reach.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
